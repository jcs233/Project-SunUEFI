{
  "schema_version": 1,
  "base_url": "https://mirrors.dotsrc.org/archlinuxarm/os/ArchLinuxARM-aarch64-latest.tar.gz",
  "base_policy": "HTTPS bootstrap from the same mirror as Nyarch; SHA256 recorded per build; signed pacman repositories",
  "desktop": "kde",
  "packages": [
    "base-devel",
    "git",
    "meson",
    "pipewire-audio",
    "pipewire-pulse",
    "gst-plugin-pipewire",
    "gst-plugins-good",
    "gst-plugins-bad",
    "ffmpeg",
    "v4l-utils",
    "libwacom",
    "libevdev",
    "libgudev",
    "alsa-utils",
    "alsa-ucm-conf",
    "bluez",
    "bluez-utils",
    "polkit",
    "vulkan-freedreno",
    "mesa-utils",
    "vulkan-tools",
    "zram-generator"
  ],
  "locale": {
    "lang": "zh_CN.UTF-8",
    "language": "zh_CN:zh",
    "timezone": "Asia/Shanghai",
    "keymap": "us"
  },
  "input_method": {
    "packages": ["noto-fonts-cjk", "ibus", "ibus-libpinyin"],
    "environment": {
      "GTK_IM_MODULE": "ibus",
      "QT_IM_MODULE": "ibus",
      "XMODIFIERS": "@im=ibus",
      "SDL_IM_MODULE": "ibus"
    },
    "autostart": "ibus-daemon -drxR"
  }
}
